<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dmit2015</groupId>
    <artifactId>student-jpa-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>student-jpa-app</name>
    <packaging>war</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.source>25</maven.compiler.source>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>11.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- =========================================================
     ADD BELOW THE DEFAULT DEPENDENCIES
     ========================================================= -->


        <!-- Jakarta Dependency Injection
             Used for @Inject and CDI dependency injection.
             Used throughout the project. -->
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
            <scope>provided</scope>
        </dependency>


        <!-- MicroProfile Config
             Reads configuration values from
             META-INF/microprofile-config.properties.
             Used throughout the project. -->
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <version>3.1.1</version>
        </dependency>


        <!-- Lombok
             Generates boilerplate code such as getters and setters.
             Used throughout the project. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
        </dependency>


        <!-- DataFaker
             Generates fake/sample data for testing and initial data.
             Used in Lesson 12 - JPA Model First. -->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>2.5.4</version>
        </dependency>


        <!-- =========================================================
             LESSON 12 - JAKARTA PERSISTENCE: MODEL FIRST
             ========================================================= -->


        <!-- Hibernate
             JPA provider that implements Jakarta Persistence.
             Performs the ORM work between Java entities and database tables. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>7.4.0.Final</version>
        </dependency>


        <!-- Oracle JDBC Driver
             Allows Java/JPA to connect to an Oracle database. -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc17</artifactId>
            <version>23.26.2.0.0</version>
        </dependency>


        <!-- H2 Database
             Provides the H2 relational database and JDBC driver. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
        </dependency>


        <!-- Microsoft SQL Server JDBC Driver
             Allows Java/JPA to connect to SQL Server. -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>13.4.0.jre11</version>
        </dependency>


        <!-- PostgreSQL JDBC Driver
             Allows Java/JPA to connect to PostgreSQL.
             This is the JDBC driver shown in the Lesson 12 slides. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.11</version>
        </dependency>


        <!-- MySQL JDBC Driver
             Allows Java/JPA to connect to MySQL. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.7.0</version>
        </dependency>


        <!-- MariaDB JDBC Driver
             Allows Java/JPA to connect to MariaDB. -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.5.8</version>
        </dependency>


        <!-- =========================================================
             LESSON 13 - JAKARTA PERSISTENCE: INTEGRATION TESTING
             Added now, but mainly used in the next JPA lesson.
             ========================================================= -->


        <!-- ShrinkWrap Maven Resolver
             Resolves Maven dependencies for Arquillian test deployments. -->
        <dependency>
            <groupId>org.jboss.shrinkwrap.resolver</groupId>
            <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
            <version>3.3.7</version>
            <scope>test</scope>
        </dependency>


        <!-- Arquillian JUnit 5
             Allows Jakarta EE integration tests to run with JUnit 5. -->
        <dependency>
            <groupId>org.jboss.arquillian.junit5</groupId>
            <artifactId>arquillian-junit5-container</artifactId>
            <version>1.10.2.Final</version>
            <scope>test</scope>
        </dependency>


        <!-- Arquillian Servlet Protocol
             Allows Arquillian tests to communicate with the
             Jakarta EE application running inside the server. -->
        <dependency>
            <groupId>org.jboss.arquillian.protocol</groupId>
            <artifactId>arquillian-protocol-servlet-jakarta</artifactId>
            <version>10.0.0.Final</version>
            <scope>test</scope>
        </dependency>


        <!-- WildFly Arquillian Container
             Allows integration tests to run against WildFly. -->
        <dependency>
            <groupId>org.wildfly.arquillian</groupId>
            <artifactId>wildfly-arquillian-container-managed</artifactId>
            <version>5.1.0.Final</version>
            <scope>test</scope>
        </dependency>


        <!-- =========================================================
             LOGGING SUPPORT
             ========================================================= -->


        <!-- Logback
             Logging implementation used by project/testing tools. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.34</version>
        </dependency>


        <!-- JBoss Logging
             Logging API used by Hibernate and other JBoss technologies. -->
        <dependency>
            <groupId>org.jboss.logging</groupId>
            <artifactId>jboss-logging</artifactId>
            <version>3.6.3.Final</version>
            <scope>provided</scope>
        </dependency>


        <!-- SLF4J Simple Logger
             Provides logging output during Arquillian/ShrinkWrap tests. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
            <scope>test</scope>
        </dependency>


        <!-- Hamcrest
             Provides assertion matchers for automated tests.
             Mainly used in Lesson 13 - Integration Testing. -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>3.0</version>
            <scope>test</scope>
        </dependency>


        <!-- JUnit Parameterized Tests
             Allows one test to run with multiple input values.
             Mainly used in Lesson 13 - Integration Testing. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- =========================================================
             JAKARTA FACES / UI DEPENDENCIES
             ========================================================= -->


        <!-- Jakarta Faces API
             Helps IntelliJ recognize Jakarta Faces and provide
             JSF code completion. -->
        <dependency>
            <groupId>jakarta.faces</groupId>
            <artifactId>jakarta.faces-api</artifactId>
            <version>4.1.2</version>
            <scope>provided</scope>
        </dependency>


        <!-- PrimeFaces
             Provides JSF components such as data tables,
             dialogs, buttons and forms. -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>15.0.15</version>
            <classifier>jakarta</classifier>
        </dependency>


        <!-- PrimeFlex
             CSS utility library for page layouts and styling. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>primeflex</artifactId>
            <version>4.0.0</version>
        </dependency>


        <!-- OmniFaces
             Provides additional utilities and components
             for Jakarta Faces applications. -->
        <dependency>
            <groupId>org.omnifaces</groupId>
            <artifactId>omnifaces</artifactId>
            <version>5.3.4</version>
        </dependency>


        <!-- OWASP HTML Sanitizer
             Helps sanitize HTML and protect against unsafe HTML/XSS. -->
        <dependency>
            <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
            <artifactId>owasp-java-html-sanitizer</artifactId>
            <version>20260313.1</version>
        </dependency>


        <!-- AssertJ
             Provides readable/fluent assertions for tests.
             Mainly used in Lesson 13 - Integration Testing. -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>



    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>

            <!-- Plugin to provision a server using Galleon, package your application in Galleon provisioned server,
deploy, redeploy, undeploy or run your application.  -->
            <!--https://docs.wildfly.org/wildfly-glow/ -->
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <version>6.0.1.Final</version>

                <configuration>
                    <feature-packs>
                        <feature-pack>
                            <location>wildfly@maven(org.jboss.universe:community-universe)#41.0.1.Final</location>
                        </feature-pack>
                    </feature-packs>
                    <!-- deploys the app on root web context -->
                    <name>ROOT.war</name>

                    <!--
                    To debug the running WildFly server from IntelliJ IDEA:
                        1. Open Run | Edit Configurations.
                        2. Add a Remote JVM Debug configuration.
                        3. Set the host to localhost.
                        4. Set the port to 8787.
                        5. Start WildFly, then start the Remote JVM Debug configuration.
                    -->
                    <debugPort>8787</debugPort>
                    <debugSuspend>false</debugSuspend>

                    <server-args>
                        <server-arg>-b=0.0.0.0</server-arg>
                    </server-args>
                </configuration>

                <executions>
                    <execution>
                        <goals>
                            <goal>package</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.48</version>
                        </path>
                        <path>
                            <groupId>org.hibernate.orm</groupId>
                            <artifactId>hibernate-jpamodelgen</artifactId>
                            <version>7.4.6.Final</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Plugin to run unit tests-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>-Xmx1024m</argLine>
                </configuration>
            </plugin>

            <!-- Plugin to run integration tests (Arquillian) -->
            <!-- mvn verify -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.6</version>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>